# Copy to Netlify → Site configuration → Environment variables (never commit real values).

# REQUIRED for production: final public origin, no trailing slash.
SITE_URL=https://www.your-domain.com

# Optional: GA4 measurement ID. Leave unset to ship with no analytics.
GA4_MEASUREMENT_ID=

# Optional: Google Search Console HTML-tag token (content value only).
# DNS verification via your domain registrar is preferred.
GOOGLE_SITE_VERIFICATION=

# Optional: FormSubmit alias string (emailed by FormSubmit after the lead inbox activates the form).
# Replaces the raw email address in the form endpoint.
FORMSUBMIT_ALIAS=
